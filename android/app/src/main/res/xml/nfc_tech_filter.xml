<?xml version="1.0" encoding="utf-8"?>
<!-- android/app/src/main/res/xml/nfc_tech_filter.xml -->
<!-- NFC Technology Filter for Καιρός Smart Journal -->
<!-- Defines which NFC tag technologies the app can handle -->

<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    
    <!-- NDEF Tags (NFC Data Exchange Format) -->
    <!-- Most NFC tags including NXP NTAG series -->
    <tech-list>
        <tech>android.nfc.tech.Ndef</tech>
    </tech-list>

    <!-- NDEF Formatable Tags -->
    <!-- Blank tags that can be formatted -->
    <tech-list>
        <tech>android.nfc.tech.NdefFormatable</tech>
    </tech-list>

    <!-- NFC-A (ISO 14443-3A) -->
    <!-- Standard for most NFC tags -->
    <tech-list>
        <tech>android.nfc.tech.NfcA</tech>
    </tech-list>

    <!-- NFC-B (ISO 14443-3B) -->
    <!-- Alternative NFC standard -->
    <tech-list>
        <tech>android.nfc.tech.NfcB</tech>
    </tech-list>

    <!-- NFC-F (FeliCa) -->
    <!-- Used in some Asian markets -->
    <tech-list>
        <tech>android.nfc.tech.NfcF</tech>
    </tech-list>

    <!-- NFC-V (ISO 15693) -->
    <!-- Vicinity cards with longer range -->
    <tech-list>
        <tech>android.nfc.tech.NfcV</tech>
    </tech-list>

    <!-- MIFARE Classic -->
    <!-- Common NFC tag type -->
    <tech-list>
        <tech>android.nfc.tech.MifareClassic</tech>
    </tech-list>

    <!-- MIFARE Ultralight -->
    <!-- Lightweight NFC tag type -->
    <tech-list>
        <tech>android.nfc.tech.MifareUltralight</tech>
    </tech-list>

    <!-- ISO-DEP (ISO 14443-4) -->
    <!-- Smart card standard -->
    <tech-list>
        <tech>android.nfc.tech.IsoDep</tech>
    </tech-list>

    <!-- Combined tech support -->
    <!-- Tags supporting both Ndef and NfcA (most common) -->
    <tech-list>
        <tech>android.nfc.tech.Ndef</tech>
        <tech>android.nfc.tech.NfcA</tech>
    </tech-list>

    <!-- Tags supporting NdefFormatable and NfcA -->
    <!-- Blank tags that can be programmed -->
    <tech-list>
        <tech>android.nfc.tech.NdefFormatable</tech>
        <tech>android.nfc.tech.NfcA</tech>
    </tech-list>

</resources>